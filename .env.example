# Generate your API key in-game with: /api
API_KEY=your_api_key_here

# Full Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Poll interval range in seconds — bot picks a random value each time
POLL_MIN_SECONDS=5
POLL_MAX_SECONDS=10

# Optional: override thumbnail images in Discord alerts (paste any public image URL)
# THUMB_TOTEM=https://...
# THUMB_EMERALD_BLOCK=https://...
# THUMB_GOLD_BLOCK=https://...
