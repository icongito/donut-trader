# ── Donut SMP API ─────────────────────────────────────────────────────────────
# Base URL for the auction list endpoint. Page number is appended automatically.
API_BASE_URL=https://api.donutsmp.net/v1/auction/list

# Optional: Bearer token / API key if the endpoint requires auth.
# Leave blank if the endpoint is public.
API_KEY=

# ── Polling ────────────────────────────────────────────────────────────────────
# How often to poll (in minutes). Default: 5
POLL_INTERVAL_MINUTES=5

# ── Discord webhook ────────────────────────────────────────────────────────────
# Full Discord webhook URL. Leave blank to disable Discord notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Hour (24h) to send the daily summary report (server local time). Default: 23
DAILY_REPORT_HOUR=23

# ── Items to track ─────────────────────────────────────────────────────────────
# Comma-separated list of item name substrings to match (case-insensitive).
# The bot will match any auction item whose name contains one of these strings.
TRACKED_ITEMS=totem,ender_pearl,shulker,end_crystal,shulker_shell

# ── API response field mapping ─────────────────────────────────────────────────
# Tell the bot which JSON keys hold each piece of data in the auction listing.
# Adjust these if the real API uses different key names.
FIELD_ITEM_NAME=item          # e.g. "TOTEM_OF_UNDYING"
FIELD_PRICE=price             # price per item (or total — see PRICE_IS_TOTAL)
FIELD_AMOUNT=amount           # stack size / quantity listed
FIELD_SELLER=seller           # seller username
FIELD_TIMESTAMP=timestamp     # ISO-8601 or Unix timestamp; leave blank if absent

# Set to true if FIELD_PRICE is the TOTAL price (we'll divide by amount for unit price).
PRICE_IS_TOTAL=false

# JSON path to the list of auctions inside the response.
# Use dot notation for nested keys, e.g. "data.auctions" or just "data".
RESPONSE_LIST_PATH=data

# JSON key (or dot path) that holds the total number of pages.
# Leave blank if the API has no pagination.
RESPONSE_TOTAL_PAGES_PATH=total_pages

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FILE=price_log.csv
